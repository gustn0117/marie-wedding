# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_SCHEMA=marie_wedding
ADMIN_PASSWORD=change-this-in-production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PortOne (포트원) V2 결제 GW
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PORTONE_API_SECRET=your-portone-v2-api-secret
PORTONE_WEBHOOK_SECRET=your-portone-webhook-signing-secret

# Resend (이메일)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=Marié <noreply@marie-wedding.hsweb.pics>

# 휴대폰 인증(SMS OTP) — NHN Cloud SMS
# 운영: SMS_PROVIDER=nhn + 아래 3개 키 필수
# 개발: SMS_PROVIDER=console (콘솔 출력만, 실제 발송 안 함)
SMS_PROVIDER=console
NHN_SMS_APP_KEY=your-app-key
NHN_SMS_SECRET_KEY=your-secret-key
NHN_SMS_SEND_NO=01012345678
# OTP 코드 해시 솔트 — 운영에선 반드시 변경 (예: openssl rand -hex 32)
OTP_HASH_SALT=marie-default-salt-change-me

# 네이버 OAuth (자체 구현 — Supabase native 미지원)
# 발급: https://developers.naver.com
# Callback URL: <NEXT_PUBLIC_APP_URL>/auth/naver/callback
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
# HMAC 키: openssl rand -hex 32
NAVER_OAUTH_STATE_SECRET=your-32-byte-random-hex
